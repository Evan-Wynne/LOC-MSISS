# Mock mode needs nothing. For chain mode run `npm run setup -- <PROGRAM_ID>`,
# which writes .env.local with these filled in (see docs/SETUP.md).
NEXT_PUBLIC_PROGRAM_ID=
NEXT_PUBLIC_RPC_URL=https://api.devnet.solana.com
NEXT_PUBLIC_USDC_MINT=
DEMO_BUYER_KEY=
DEMO_SELLER_KEY=
DEMO_INSPECTOR_KEY=
NEXT_PUBLIC_DEMO_BUYER=
NEXT_PUBLIC_DEMO_SELLER=
NEXT_PUBLIC_DEMO_INSPECTOR=
# Set to "false" to hide the dashed PLACEHOLDER tags (e.g. for the pitch).
NEXT_PUBLIC_SHOW_PLACEHOLDERS=true
